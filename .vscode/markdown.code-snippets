{
  "Folklore Story": {
    "prefix": ["folklore", "post"],
    "body": [
      "---",
      "title: \"${1:Story Title}\"",
      "date: \"${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}:00\"",
      "slug: \"${2:story-slug}\"",
      "categories: [\"${3|Folklore,Dispatches|}\"]",
      "tags: [\"${4:tag}\"]",
      "isFolklore: true",
      "excerpt: \"${5:Short summary of the story...}\"",
      "---",
      "",
      "# ${1:Story Title}",
      "",
      "$0"
    ],
    "description": "Insert standard Folklore / Dispatch frontmatter template"
  },
  "Mermaid Diagram": {
    "prefix": "mermaid",
    "body": [
      "```mermaid",
      "graph LR",
      "  ${1:A}[${2:Start}] --> ${3:B}[${4:End}]",
      "```",
      "$0"
    ],
    "description": "Insert a Mermaid diagram block"
  },
  "Math Block": {
    "prefix": "math",
    "body": [
      "$$",
      "${1:f(x) = \\int_{-\\infty}^{\\infty} e^{-x^2} dx}",
      "$$",
      "$0"
    ],
    "description": "Insert KaTeX block math"
  }
}

