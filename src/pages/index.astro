---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelViewer3D from '../components/ModelViewer3D.astro';
import FolkloreCard from '../components/FolkloreCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');

// Sort by date descending
allPosts.sort((a, b) => new Date(b.data.date || '').getTime() - new Date(a.data.date || '').getTime());

// Folklore stories
const folklorePosts = allPosts.filter(p => p.data.isFolklore || p.data.categories.includes('Folklore') || p.data.tags.includes('folklore'));
const featuredFolklore = folklorePosts.slice(0, 4);

// Publications
const publicationPosts = allPosts.filter(p => p.data.isPublication || p.data.categories.includes('Publications') || p.data.tags.includes('publication'));
const recentPubs = (publicationPosts.length > 0 ? publicationPosts : allPosts).slice(0, 4);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="py-6 md:py-12 border-b border-neutral-200 dark:border-neutral-800">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 mb-5">
          <span>🎬 Motion Picture Science</span>
          <span>&bull;</span>
          <span>🧠 Cognitive Perception</span>
          <span>&bull;</span>
          <span>📐 3D Geometry</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-serif font-bold tracking-tight text-neutral-900 dark:text-neutral-50 leading-[1.15]">
          Flip Phillips
        </h1>
        <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-300 font-serif italic mt-2">
          Professor of Motion Picture Science &bull; Rochester Institute of Technology
        </p>
        <p class="mt-4 text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans">
          My research and teaching focuses on the human perception of materials, 3D shape, and motion — primarily through vision and touch. My trajectory spans undergraduate training in architecture and computer graphics at OSU’s Computer Graphics Research Group, UI and animation at <strong>Pixar Animation Studios</strong> (where I was the original <em>‘Animation Scientist’</em>), and cognitive science, neuroscience, and mathematical modeling at OSU, Skidmore, and RIT.
        </p>

        <div class="mt-6 flex flex-wrap gap-3 font-sans">
          <a
            href="/folklore"
            class="px-5 py-2.5 rounded-xl font-medium text-sm bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-white transition-all shadow-sm"
          >
            Explore Folklore & Stories &rarr;
          </a>
          <a
            href="/publications"
            class="px-5 py-2.5 rounded-xl font-medium text-sm border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          >
            Publications & Papers
          </a>
          <a
            href="/software"
            class="px-5 py-2.5 rounded-xl font-medium text-sm border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          >
            Software & 3D Lab
          </a>
        </div>
      </div>

      <div class="w-full md:w-72 p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-sm">
        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100 mb-3 text-xs tracking-wider uppercase font-mono">
          Affiliations & Links
        </h3>
        <ul class="space-y-2 text-xs text-neutral-600 dark:text-neutral-400">
          <li><strong>Appointments:</strong> School of Film & Animation, Center for Imaging Science, MAGIC Center</li>
          <li><strong>Lab GitHub:</strong> <a href="https://github.com/ritmps" class="text-blue-600 dark:text-blue-400 hover:underline">github.com/ritmps</a></li>
          <li><strong>Personal GitHub:</strong> <a href="https://github.com/flipphillips" class="text-blue-600 dark:text-blue-400 hover:underline">github.com/flipphillips</a></li>
          <li><strong>Current Courses:</strong> Virtual Production I & II, Intro to Imaging</li>
          <li><strong>Honors:</strong> Project Prakash, VES Member, VSS Member</li>
          <li><strong>Music:</strong> <a href="https://drums.flipphillips.com" class="text-blue-600 dark:text-blue-400 hover:underline">History of Jazz Drumming</a></li>
          <li class="pt-2 italic text-neutral-500 font-mono text-[11px]">“Part machine — titanium, Dacron, and cow”</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Interactive 3D Model Viewer Section -->
  <section class="py-12 border-b border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between mb-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold">
          Interactive Research Artifact
        </span>
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          Gibson’s Feelies in 3D
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
          Direct laser scans of J.J. Gibson's historic tactile stimuli, cleaned and prepared in Mathematica for 3D printing and haptic shape discrimination experiments.
        </p>
      </div>
      <a href="/software" class="hidden md:inline-flex text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">
        All 3D Datasets &rarr;
      </a>
    </div>

    <!-- The 3D Component with Three.js -->
    <ModelViewer3D
      modelUrl="/models/feelie1.glb"
      title="Gibson's Feelie #1 (NextEngine Laser Scan)"
      caption="Click & drag to rotate in real-time. Toggle solid/wireframe or pause rotation."
    />
  </section>

  <!-- Featured Folklore Shelf -->
  <section class="py-12 border-b border-neutral-200 dark:border-neutral-800">
    <div class="flex items-end justify-between mb-8">
      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold">
          Archival Chronicles
        </span>
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          Folklore: Pixar, Bowie & Computer Graphics
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
          Firsthand stories from the pioneering days of computer animation, reference stunts in parking lots, and uncanny encounters.
        </p>
      </div>
      <a href="/folklore" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline whitespace-nowrap">
        All {folklorePosts.length} Stories &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredFolklore.map(post => (
        <FolkloreCard
          title={post.data.title}
          date={post.data.date || ''}
          slug={post.data.slug || post.id}
          excerpt={post.data.excerpt}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>

  <!-- Recent Research & Publications -->
  <section class="py-12">
    <div class="flex items-end justify-between mb-8">
      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold">
          Selected Research
        </span>
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-neutral-900 dark:text-neutral-100 mt-1">
          Recent Publications & Preprints
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
          Visual perception, volumetric motion capture, material reflectance, and haptic discrimination.
        </p>
      </div>
      <a href="/publications" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline whitespace-nowrap">
        All Publications &rarr;
      </a>
    </div>

    <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
      {recentPubs.map(pub => (
        <article class="py-5 first:pt-0 last:pb-0 flex flex-col md:flex-row md:items-baseline justify-between gap-4">
          <div class="max-w-2xl">
            <h3 class="text-base font-serif font-bold text-neutral-900 dark:text-neutral-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              <a href={`/blog/${pub.data.slug || pub.id}`}>
                {pub.data.title}
              </a>
            </h3>
            {pub.data.excerpt && (
              <p class="mt-1 text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2">
                {pub.data.excerpt.replace(/\[Read More\].*$/, '')}
              </p>
            )}
          </div>
          <div class="text-xs font-mono text-neutral-400 whitespace-nowrap">
            {new Date(pub.data.date || '').toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
