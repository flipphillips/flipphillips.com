---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { publications } from '../../data/publications';

// Sort descending by year
const sortedPubs = [...publications].sort((a, b) => b.year - a.year);

const journalCount = sortedPubs.filter(p => p.type === 'journal').length;
const confCount = sortedPubs.filter(p => p.type === 'conference').length;
const highlightCount = sortedPubs.filter(p => p.highlight).length;
---

<BaseLayout
  title="Publications & Research — Flip Phillips"
  description="Peer-reviewed scientific journal articles, conference proceedings, and book chapters by Flip Phillips."
>
  <div class="py-6">
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 mb-4">
        <span>📚 Complete Bibliography &bull; {sortedPubs.length} Works (1986–2026)</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-neutral-900 dark:text-neutral-50 tracking-tight leading-tight">
        Publications & Research
      </h1>
      <p class="mt-4 text-base text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans max-w-3xl">
        A chronological archive of peer-reviewed journal articles, conference proceedings, book chapters, and technical reports across visual and haptic shape perception, materials, stereopsis, and computer animation.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-xs">
        <a
          href="/pubs/Flip%20Phillips%20External%20CV.pdf"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 font-medium transition-all shadow-xs"
        >
          📄 Download Full Curriculum Vitæ (PDF) &rarr;
        </a>
        <a
          href="https://scholar.google.com/citations?user=b9u-pTsAAAAJ&hl=en"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 font-medium transition-colors"
        >
          🎓 Google Scholar Profile &rarr;
        </a>
        <a
          href="https://neurotree.org/neurotree/tree.php?pid=16082"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 font-medium transition-colors"
        >
          🌳 Academic Lineage (Neurotree) &rarr;
        </a>
      </div>

      <!-- Filter Controls -->
      <div class="mt-8 flex flex-wrap items-center gap-2 font-mono text-xs" id="pub-filter-container">
        <button
          data-filter="all"
          class="pub-filter-btn px-3 py-1.5 rounded-lg bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 font-medium transition-colors cursor-pointer"
        >
          All ({sortedPubs.length})
        </button>
        <button
          data-filter="highlight"
          class="pub-filter-btn px-3 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 font-medium transition-colors cursor-pointer"
        >
          ✦ Selected Works ({highlightCount})
        </button>
        <button
          data-filter="journal"
          class="pub-filter-btn px-3 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 font-medium transition-colors cursor-pointer"
        >
          Journal Articles ({journalCount})
        </button>
        <button
          data-filter="conference"
          class="pub-filter-btn px-3 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 font-medium transition-colors cursor-pointer"
        >
          Conferences ({confCount})
        </button>
        <button
          data-filter="other"
          class="pub-filter-btn px-3 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 font-medium transition-colors cursor-pointer"
        >
          Books & Reports
        </button>
      </div>
    </header>

    <!-- Publications List -->
    <div class="space-y-6" id="publications-list">
      {sortedPubs.map(pub => {
        let categories = ['all', pub.type];
        if (pub.highlight) categories.push('highlight');
        if (pub.type === 'book' || pub.type === 'preprint' || pub.type === 'techreport' || pub.type === 'magazine') {
          categories.push('other');
        }

        return (
          <div class="pub-item transition-opacity" data-categories={categories.join(' ')}>
            <PublicationCard pub={pub} />
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.pub-filter-btn');
  const pubItems = document.querySelectorAll<HTMLElement>('.pub-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter || 'all';

      // Update button active styling
      filterBtns.forEach(b => {
        b.classList.remove('bg-neutral-900', 'text-white', 'dark:bg-neutral-100', 'dark:text-neutral-900');
        b.classList.add('bg-neutral-100', 'dark:bg-neutral-800', 'text-neutral-600', 'dark:text-neutral-300');
      });
      btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-800', 'text-neutral-600', 'dark:text-neutral-300');
      btn.classList.add('bg-neutral-900', 'text-white', 'dark:bg-neutral-100', 'dark:text-neutral-900');

      // Filter publications
      pubItems.forEach(item => {
        const categories = (item.dataset.categories || '').split(' ');
        if (filter === 'all' || categories.includes(filter)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
