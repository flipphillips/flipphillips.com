---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { publications } from '../../data/publications';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => {
    const slug = (post.data.slug || post.id.replace(/\.md$/, ''));
    return {
      params: { slug: decodeURIComponent(slug) },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date ? new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : '';

// Find companion publication if linked via frontmatter or bibtex post field
const linkedPub = publications.find(p =>
  p.id === post.data.publication ||
  (p.post && (p.post.includes(slug) || p.post.endsWith(`/${slug}`)))
);
const pubDoiUrl = linkedPub?.doi ? (linkedPub.doi.startsWith('http') ? linkedPub.doi : `https://doi.org/${linkedPub.doi}`) : null;
---

<BaseLayout title={`${post.data.title} — Folklore — Flip Phillips`} description={post.data.excerpt}>
  <article class="max-w-3xl mx-auto py-6" data-pagefind-filter="type:Folklore">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-4">
        {formattedDate && <time datetime={post.data.date}>{formattedDate}</time>}
        {post.data.isFolklore && (
          <span class="px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 font-sans font-medium text-[11px]">
            ✦ Folklore Story
          </span>
        )}
        {post.data.categories && post.data.categories.length > 0 && (
          <>
            <span>&bull;</span>
            <div class="flex gap-1.5">
              {post.data.categories.map(cat => (
                <span class="px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-sans text-[11px]">
                  {cat}
                </span>
              ))}
            </div>
          </>
        )}
      </div>

      <h1 class="text-3xl md:text-5xl font-serif font-bold text-neutral-900 dark:text-neutral-50 leading-[1.2]">
        {post.data.title}
      </h1>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
          {post.data.tags.map(tag => (
            <span>#{tag}</span>
          ))}
        </div>
      )}
    </header>

    {linkedPub && (
      <aside class="mb-10 p-5 rounded-2xl bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200/80 dark:border-blue-900/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="min-w-0">
          <div class="flex items-center gap-2 text-xs font-mono text-blue-700 dark:text-blue-300 font-semibold mb-1">
            <span>📄 Companion Academic Publication</span>
            <span>&bull;</span>
            <span>{linkedPub.year}</span>
          </div>
          <p class="text-base font-serif font-bold text-neutral-900 dark:text-neutral-100 leading-snug">
            {linkedPub.title}
          </p>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 font-sans italic mt-1">
            {linkedPub.venue}
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0 font-mono text-xs">
          {linkedPub.pdf && (
            <a
              href={linkedPub.pdf}
              target="_blank"
              class="px-3 py-1.5 rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:opacity-90 font-medium inline-flex items-center gap-1.5 shadow-xs"
            >
              <span>📄</span>
              <span>PDF</span>
            </a>
          )}
          {pubDoiUrl && (
            <a
              href={pubDoiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg border border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-600 text-neutral-700 dark:text-neutral-300 inline-flex items-center gap-1.5 font-medium transition-colors"
            >
              <span>DOI &rarr;</span>
            </a>
          )}
        </div>
      </aside>
    )}

    <!-- Content Body with Markdown / Typography -->
    <div class="prose prose-neutral dark:prose-invert prose-lg max-w-none font-sans
      prose-headings:font-serif prose-headings:font-bold prose-headings:tracking-tight
      prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
      prose-img:rounded-xl prose-img:shadow-md prose-img:my-6
      prose-blockquote:border-l-blue-500 prose-blockquote:font-serif prose-blockquote:italic
      prose-pre:bg-neutral-900 prose-pre:text-neutral-100 prose-pre:rounded-xl">
      <Content />
    </div>

    <!-- Navigation footer -->
    <div class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex justify-between items-center text-sm font-sans">
      <a href="/folklore" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">
        &larr; Back to all Folklore
      </a>
      <a href="/" class="font-medium text-neutral-500 dark:text-neutral-400 hover:underline">
        Home &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
