---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FolkloreCard from '../../components/FolkloreCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const folklorePosts = allPosts.filter(p => p.data.isFolklore || p.data.categories.includes('Folklore') || p.data.tags.includes('folklore'));
folklorePosts.sort((a, b) => new Date(b.data.date || '').getTime() - new Date(a.data.date || '').getTime());
---

<BaseLayout title="Folklore & Archival Stories — Flip Phillips" description="Personal chronicles from the early days of computer graphics, Pixar, Ohio State CGRG, and beyond.">
  <div class="py-6">
    <header class="mb-12 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 mb-4">
        <span>📖 Archival Oral History</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-neutral-900 dark:text-neutral-50 tracking-tight leading-tight">
        Folklore & Chronicles
      </h1>
      <p class="mt-4 text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
        Pioneering computer graphics wasn't just algorithms and framebuffers — it was jumping over trash cans in parking lots for <em>Luxo Jr.</em> reference footage, drawing tools on the Pixar Image Computer, receiving hand-delivered Cat Buses from Hayao Miyazaki, and answering phone calls from David Bowie looking for ideas.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {folklorePosts.map(post => (
        <FolkloreCard
          title={post.data.title}
          date={post.data.date || ''}
          slug={post.data.slug || post.id.replace(/\.md$/, '')}
          excerpt={post.data.excerpt}
          tags={post.data.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>
