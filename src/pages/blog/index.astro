---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
allPosts.sort((a, b) => new Date(b.data.date || '').getTime() - new Date(a.data.date || '').getTime());
---

<BaseLayout title="Blog Archive — Flip Phillips" description="All 140 posts and articles spanning graphics, perception, folklore, and research.">
  <div class="py-6">
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <span class="text-xs font-mono uppercase tracking-wider text-amber-600 dark:text-amber-400 font-semibold">
        Chronological Archive
      </span>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-neutral-900 dark:text-neutral-100 mt-1">
        Blog & Essays
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">
        {allPosts.length} posts spanning computer graphics, vision science, haptics, software experiments, and history.
      </p>
    </header>

    <div class="space-y-8">
      {allPosts.map(post => {
        const formattedDate = post.data.date ? new Date(post.data.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }) : '';

        return (
          <article class="group pb-8 border-b border-neutral-100 dark:border-neutral-800/80 last:border-0">
            <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-1 text-xs text-neutral-400 font-mono mb-2">
              <time datetime={post.data.date}>{formattedDate}</time>
              {post.data.categories && post.data.categories.length > 0 && (
                <span class="text-neutral-500">{post.data.categories.join(' &bull; ')}</span>
              )}
            </div>

            <h2 class="text-xl font-serif font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
              <a href={`/blog/${post.data.slug || post.id.replace(/\.md$/, '')}`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.excerpt && (
              <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed">
                {post.data.excerpt.replace(/\[Read More\].*$/, '')}
              </p>
            )}

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
                {post.data.tags.slice(0, 5).map(tag => (
                  <span>#{tag}</span>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
