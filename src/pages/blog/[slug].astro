---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => {
    const slug = (post.data.slug || post.id.replace(/\.md$/, ''));
    return {
      params: { slug: decodeURIComponent(slug) },
      props: { slug },
    };
  });
}

const { slug } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=/folklore/${slug}`} />
    <link rel="canonical" href={`/folklore/${slug}`} />
    <title>Redirecting to Folklore...</title>
  </head>
  <body>
    <p>Redirecting to <a href={`/folklore/${slug}`}>/folklore/{slug}</a>...</p>
  </body>
</html>
