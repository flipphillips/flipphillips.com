---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModelViewer3D from '../../components/ModelViewer3D.astro';
---

<BaseLayout title="Software, Data & Geometry — Flip Phillips" description="Open source code, 3D laser-scanned datasets, and geometric stimuli for perception research.">
  <div class="py-6">
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <span class="text-xs font-mono uppercase tracking-wider text-blue-600 dark:text-blue-400 font-semibold">
        Open Science & Tools
      </span>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-neutral-900 dark:text-neutral-100 mt-1">
        Software, Data & Geometry
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-sans">
        A collection of tools, datasets, and 3D geometric stimuli used in our lab and shared with the broader research community under CC, MIT, and GPL licenses.
      </p>

      <div class="mt-4 flex flex-wrap gap-3">
        <a href="https://github.com/ritmps" target="_blank" class="px-3 py-1.5 rounded-lg text-xs font-mono bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90">
          github.com/ritmps &rarr;
        </a>
        <a href="https://github.com/skidvision" target="_blank" class="px-3 py-1.5 rounded-lg text-xs font-mono border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800">
          github.com/skidvision &rarr;
        </a>
        <a href="https://github.com/flipphillips" target="_blank" class="px-3 py-1.5 rounded-lg text-xs font-mono border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800">
          github.com/flipphillips &rarr;
        </a>
      </div>
    </header>

    <!-- 3D Geometry Section -->
    <section class="mb-16">
      <div class="mb-6">
        <h2 class="text-2xl font-serif font-bold text-neutral-900 dark:text-neutral-100">
          3D Geometric Stimuli & Datasets
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1 font-sans">
          Laser scans and mathematically synthesized manifolds for haptic and visual shape discrimination experiments.
        </p>
      </div>

      <!-- Live 3D Model Viewer for Gibson's Feelies -->
      <ModelViewer3D
        modelUrl="/models/feelie1.glb"
        title="Gibson's Feelies (Laser Scanned 3D Dataset)"
        caption="Feelie #1 — NextEngine laser scan from the Archives of the History of American Psychology. Rotate and inspect."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900">
          <h3 class="font-serif font-bold text-base text-neutral-900 dark:text-neutral-100">Gibson’s Feelies</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed font-sans">
            Ten historic tactile sculptures informally described by J.J. Gibson (1962). Scanned with a NextEngine laser scanner, cleaned in Mathematica, and prepared for 3D printing.
          </p>
          <a href="https://github.com/skidvision/Feelies" target="_blank" class="inline-block mt-3 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            Download OBJs & STLs &rarr;
          </a>
        </div>

        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900">
          <h3 class="font-serif font-bold text-base text-neutral-900 dark:text-neutral-100">Bell Peppers</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed font-sans">
            High-resolution 3D scanned models of natural bell peppers (<em>Capsicum annuum</em>) used for solid shape discrimination and material perception studies.
          </p>
          <a href="https://github.com/skidvision" target="_blank" class="inline-block mt-3 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            View on GitHub &rarr;
          </a>
        </div>

        <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900">
          <h3 class="font-serif font-bold text-base text-neutral-900 dark:text-neutral-100">Glavens</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed font-sans">
            Parametrically generated 3D organic manifolds with controllable curvature, surface normals, and bump frequencies for psychophysical experiments.
          </p>
          <a href="https://github.com/skidvision" target="_blank" class="inline-block mt-3 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            View on GitHub &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Software & Hardware -->
    <section>
      <div class="mb-6">
        <h2 class="text-2xl font-serif font-bold text-neutral-900 dark:text-neutral-100">
          Software & Hardware Projects
        </h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1 font-sans">
          Open hardware and experimental tools developed for virtual production and psychophysics.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
          <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
            <span>Hardware & Vision</span>
            <span class="text-blue-500 font-semibold">Active</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-neutral-900 dark:text-neutral-100">
            OpenVolCap / ChumpCam
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans">
            Affordable, flexible open-source devices and sensor arrays for volumetric capture, motion capture, and camera tracking in virtual production.
          </p>
          <a href="https://ritmps.github.io/chumps/" target="_blank" class="inline-block mt-4 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            Visit Project Site (ritmps.github.io/chumps) &rarr;
          </a>
        </div>

        <div class="p-6 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
          <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
            <span>Developer Tooling</span>
            <span class="text-neutral-400">VSCode Extension</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-neutral-900 dark:text-neutral-100">
            VSCode for Wolfram Mathematica
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans">
            Language integration, syntax highlighting, and execution tooling for Wolfram Language development within Visual Studio Code.
          </p>
          <a href="https://github.com/flipphillips" target="_blank" class="inline-block mt-4 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            Repository &rarr;
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
