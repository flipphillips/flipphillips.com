            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg text-xs font-mono font-semibold border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          >
            🎓 Google Scholar
          </a>
          <a
            href="https://neurotree.org/neurotree/tree.php?pid=16082"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-lg text-xs font-mono font-semibold border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
          >
