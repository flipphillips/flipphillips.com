---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, any> | Record<string, any>[];
  extraMeta?: Array<{ name: string; content: string }>;
  noindex?: boolean;
}

const SITE_URL = 'https://flipphillips.com';

const {
  title = "Flip Phillips — Professor of Motion Picture Science",
  description = "Flip Phillips is Professor of Motion Picture Science at the Rochester Institute of Technology (RIT), perceptual scientist, and early Pixar Animation Studios 'Animation Scientist' (RenderMan). Research in human perception of 3D shape, materials, computer graphics, and motion.",
  image = "/images/uploads/2017/03/L1000017.jpg",
  imageAlt = "Flip Phillips — Professor of Motion Picture Science at Rochester Institute of Technology",
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  extraMeta = [],
  noindex = false,
} = Astro.props;

// Clean any legacy "[Read More](...)" suffix from post excerpts
const cleanDescription = (description || '')
  .replace(/\[Read More\]\(.*?\)/gi, '')
  .replace(/\[Read More\].*$/gi, '')
  .replace(/\s+/g, ' ')
  .trim();

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || SITE_URL).toString();
const ogImageUrl = image
  ? (image.startsWith('http') ? image : new URL(image, Astro.site || SITE_URL).toString())
  : new URL('/images/uploads/2017/03/L1000017.jpg', Astro.site || SITE_URL).toString();

const personEntity = {
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  "name": "Flip Phillips",
  "givenName": "Flip",
  "familyName": "Phillips",
  "alternateName": ["F. Phillips", "F. H. Phillips"],
  "honorificPrefix": "Prof.",
  "honorificSuffix": "Ph.D.",
  "jobTitle": "Professor of Motion Picture Science",
  "description": "Professor of Motion Picture Science at the Rochester Institute of Technology (MAGIC Center, School of Film and Animation, and Center for Imaging Science), perceptual psychologist, early Pixar Animation Studios 'Animation Scientist' (RenderMan team), and jazz drummer.",
  "disambiguatingDescription": "American perceptual scientist, computer graphics pioneer, early Pixar 'Animation Scientist', Professor of Motion Picture Science at Rochester Institute of Technology (RIT), and drummer. Son of jazz drummer Flip Phillips; not related to and not to be confused with the late jazz tenor saxophonist Flip Phillips (Joseph Edward Filipelli, 1915–2001).",
  "url": SITE_URL,
  "image": {
    "@type": "ImageObject",
    "@id": `${SITE_URL}/#portrait`,
    "url": `${SITE_URL}/images/uploads/2017/03/L1000017.jpg`,
    "caption": "Flip Phillips portrait by Roland Fleming"
  },
  "email": "mailto:flip.phillips@rit.edu",
  "worksFor": {
    "@type": "CollegeOrUniversity",
    "name": "Rochester Institute of Technology",
    "alternateName": "RIT",
    "url": "https://www.rit.edu",
    "department": [
      {
        "@type": "Organization",
        "name": "School of Film and Animation (SoFA)",
        "url": "https://www.rit.edu/artdesign/school-film-and-animation"
      },
      {
        "@type": "Organization",
        "name": "Chester F. Carlson Center for Imaging Science (CIS)",
        "url": "https://www.rit.edu/science/chester-f-carlson-center-imaging-science"
      },
      {
        "@type": "Organization",
        "name": "MAGIC Center",
        "url": "https://www.rit.edu/magic"
      }
    ]
  },
  "affiliation": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Rochester Institute of Technology",
      "url": "https://www.rit.edu"
    },
    {
      "@type": "CollegeOrUniversity",
      "name": "Skidmore College",
      "description": "Former Professor of Psychology and Neuroscience"
    },
    {
      "@type": "Corporation",
      "name": "Pixar Animation Studios",
      "description": "Original 'Animation Scientist' and Technical Director (1987–1992), RenderMan development team"
    }
  ],
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "The Ohio State University",
      "department": "Computer Graphics Research Group (CGRG) & Department of Psychology",
      "url": "https://www.osu.edu"
    }
  ],
  "memberOf": [
    {
      "@type": "Organization",
      "name": "Visual Effects Society (VES)"
    },
    {
      "@type": "Organization",
      "name": "Vision Sciences Society (VSS)"
    },
    {
      "@type": "Organization",
      "name": "Project Prakash"
    }
  ],
  "award": [
    "IEEE Milestone Award for Pixar RenderMan (2023)",
    "Visual Effects Society (VES) Member (2025)"
  ],
  "knowsAbout": [
    "Visual Perception",
    "Haptic Perception",
    "3D Shape Perception",
    "Material Perception",
    "Computer Graphics",
    "Computer Animation",
    "RenderMan",
    "Motion Picture Science",
    "Virtual Production",
    "Psychophysics",
    "Cognitive Psychology",
    "Neuroscience",
    "Wolfram Mathematica",
    "Jazz Drumming"
  ],
  "sameAs": [
    "https://orcid.org/0000-0002-7281-8958",
    "https://scholar.google.com/citations?user=b9u-pTsAAAAJ&hl=en",
    "https://www.linkedin.com/in/flipphillips",
    "https://github.com/flipphillips",
    "https://github.com/ritmps",
    "https://github.com/skidvision",
    "https://bsky.app/profile/flipphillips.com",
    "https://neurotree.org/neurotree/tree.php?pid=16082",
    "https://www.rit.edu/directory/fxpppr-flip-phillips",
    "https://drums.flipphillips.com"
  ]
};

const websiteEntity = {
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "url": SITE_URL,
  "name": "Flip Phillips",
  "alternateName": "Flip Phillips — Professor of Motion Picture Science at RIT",
  "description": "Research, publications, software, and computer graphics folklore of Flip Phillips, Professor of Motion Picture Science at the Rochester Institute of Technology.",
  "publisher": { "@id": `${SITE_URL}/#person` },
  "author": { "@id": `${SITE_URL}/#person` },
  "inLanguage": "en-US"
};

const extraJsonLdNodes = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    personEntity,
    websiteEntity,
    ...extraJsonLdNodes
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={cleanDescription} />
    <meta name="author" content="Flip Phillips" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Identity & IndieWeb rel="me" verification links -->
    <link rel="me" href="https://orcid.org/0000-0002-7281-8958" />
    <link rel="me" href="https://github.com/flipphillips" />
    <link rel="me" href="https://bsky.app/profile/flipphillips.com" />
    <link rel="me" href="https://www.linkedin.com/in/flipphillips" />
    <link rel="me" href="https://scholar.google.com/citations?user=b9u-pTsAAAAJ&hl=en" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="Flip Phillips" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {type === 'profile' && (
      <>
        <meta property="profile:first_name" content="Flip" />
        <meta property="profile:last_name" content="Phillips" />
        <meta property="profile:username" content="flipphillips" />
      </>
    )}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
    )}
    {type === 'article' && (
      <meta property="article:author" content="Flip Phillips" />
    )}
    {type === 'article' && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter / Bluesky / Social Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {extraMeta.map((m) => (
      <meta name={m.name} content={m.content} />
    ))}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>

    <!-- Structured Data (Schema.org JSON-LD for Google/Bing Knowledge Graph & Disambiguation) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- Google Fonts: IBM Plex Family (Sans, Serif, Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 min-h-screen flex flex-col antialiased selection:bg-blue-100 dark:selection:bg-blue-900/60 selection:text-blue-950 dark:selection:text-blue-100 transition-colors font-sans">
    <Header />
    <main data-pagefind-body class="flex-grow max-w-5xl w-full mx-auto px-6 py-10">
      <slot />
    </main>
    <Footer />

    <!-- Global Keyboard Shortcut (Cmd+K / Ctrl+K for Search) -->
    <script is:inline>
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (window.location.pathname !== '/search') {
            window.location.href = '/search';
          } else {
            const input = document.querySelector('.pagefind-ui__search-input');
            if (input) input.focus();
          }
        }
      });
    </script>

    <!-- Bundled Mermaid Renderer -->
    <script>
      import mermaid from 'mermaid';

      async function renderMermaid() {
        const mermaidBlocks = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"], pre.mermaid, code.language-mermaid');
        if (mermaidBlocks.length === 0) return;

        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'neutral',
          fontFamily: 'IBM Plex Sans, sans-serif'
        });

        for (const el of Array.from(mermaidBlocks)) {
          const pre = el.tagName === 'PRE' ? el : (el.closest('pre') || el);
          const code = (pre.textContent || '').trim();
          if (!code) continue;

          try {
            const id = 'mermaid-' + Math.random().toString(36).substring(7);
            const { svg } = await mermaid.render(id, code);
            const div = document.createElement('div');
            div.className = 'my-8 flex justify-center overflow-x-auto p-6 bg-neutral-50 dark:bg-neutral-900 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm';
            div.innerHTML = svg;
            pre.replaceWith(div);
          } catch (err) {
            console.error('Mermaid render error:', err);
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaid);
      } else {
        renderMermaid();
      }
    </script>

    <!-- Wolfram Cloud Notebook Embedder -->
    <script>
      async function initWolframEmbeds() {
        const cards = document.querySelectorAll<HTMLElement>('.wolfram-embed-card[data-wolfram-url]');
        if (cards.length === 0) return;

        let embedFn: any = null;
        try {
          const mod = await import('wolfram-notebook-embedder');
          embedFn = mod.embed || mod.default?.embed || mod.default;
        } catch (err) {
          console.error('Failed to load wolfram-notebook-embedder package:', err);
          return;
        }

        if (typeof embedFn !== 'function') {
          console.error('embed function not found in wolfram-notebook-embedder');
          return;
        }

        for (const card of Array.from(cards)) {
          const url = card.dataset.wolframUrl;
          const container = card.querySelector<HTMLElement>('.wolfram-embed-container');
          if (!url || !container || container.dataset.initialized) continue;
          container.dataset.initialized = 'true';

          const observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                observer.disconnect();
                embedFn(url, container, {
                  width: null,
                  maxHeight: Infinity,
                  allowInteract: true,
                  showBorder: false,
                  showRenderProgress: true
                }).then(() => {
                  const loading = container.querySelector('.wolfram-embed-loading');
                  if (loading) loading.remove();
                }).catch((err: any) => {
                  console.error('Failed to embed Wolfram Cloud notebook:', err);
                  container.innerHTML = `<div class="p-6 text-center text-xs font-mono text-neutral-500">
                    <p class="mb-2">Unable to load interactive Wolfram embed directly.</p>
                    <a href="${url}" target="_blank" rel="noopener noreferrer" class="text-red-600 dark:text-red-400 underline">Open in Wolfram Cloud &rarr;</a>
                  </div>`;
                });
              }
            }
          }, { rootMargin: '200px' });

          observer.observe(card);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWolframEmbeds);
      } else {
        initWolframEmbeds();
      }
    </script>
  </body>
</html>
