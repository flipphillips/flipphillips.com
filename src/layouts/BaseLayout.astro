---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Flip Phillips — Professor of Motion Picture Science",
  description = "Research and teaching in human perception, 3D shape, materials, computer graphics, and motion at the Rochester Institute of Technology."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Google Fonts: IBM Plex Family (Sans, Serif, Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 min-h-screen flex flex-col antialiased selection:bg-blue-100 dark:selection:bg-blue-900/60 selection:text-blue-950 dark:selection:text-blue-100 transition-colors font-sans">
    <Header />
    <main class="flex-grow max-w-5xl w-full mx-auto px-6 py-10">
      <slot />
    </main>
    <Footer />

    <!-- Mermaid loader script for code blocks -->
    <script type="module">
      const mermaidBlocks = document.querySelectorAll('pre.mermaid, code.language-mermaid, pre > code.language-mermaid');
      if (mermaidBlocks.length > 0) {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'neutral',
          fontFamily: 'IBM Plex Sans, sans-serif'
        });
        
        for (const el of mermaidBlocks) {
          const pre = el.tagName === 'PRE' ? el : el.parentElement;
          const code = el.textContent || '';
          try {
            const id = 'mermaid-' + Math.random().toString(36).substring(7);
            const { svg } = await mermaid.render(id, code);
            const div = document.createElement('div');
            div.className = 'my-6 flex justify-center overflow-x-auto p-4 bg-neutral-50 dark:bg-neutral-900 rounded-xl border border-neutral-200 dark:border-neutral-800';
            div.innerHTML = svg;
            pre.replaceWith(div);
          } catch (e) {
            console.error('Mermaid render error:', e);
          }
        }
      }
    </script>
  </body>
</html>
