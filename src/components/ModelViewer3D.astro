---
interface Props {
  modelUrl?: string;
  title?: string;
  caption?: string;
}

const {
  modelUrl = "/models/feelie1.obj",
  title = "Gibson's Feelie #1 (3D Laser Scan)",
  caption = "Interact: Click & drag to rotate, scroll to zoom, right-click to pan."
} = Astro.props;

const containerId = 'viewer-' + Math.random().toString(36).substring(7);
---

<div class="my-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-900 overflow-hidden shadow-xl text-neutral-100">
  <div class="px-6 py-4 border-b border-neutral-800 flex flex-wrap items-center justify-between gap-3 bg-neutral-950/60">
    <div>
      <h3 class="text-base font-semibold text-neutral-100 flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {title}
      </h3>
      <p class="text-xs text-neutral-400 mt-0.5 font-mono">{caption}</p>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <button id={`${containerId}-wireframe`} class="px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors cursor-pointer">
        Wireframe
      </button>
      <button id={`${containerId}-autorotate`} class="px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors cursor-pointer">
        Pause Spin
      </button>
      <button id={`${containerId}-reset`} class="px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-300 transition-colors cursor-pointer">
        Reset
      </button>
    </div>
  </div>

  <div class="relative w-full h-[460px] bg-gradient-to-b from-neutral-900 to-neutral-950 flex items-center justify-center">
    <div id={`${containerId}-loading`} class="absolute inset-0 flex flex-col items-center justify-center bg-neutral-900/90 z-10 transition-opacity">
      <div class="w-10 h-10 border-4 border-amber-500/20 border-t-amber-500 rounded-full animate-spin"></div>
      <p class="text-xs text-neutral-400 mt-3 font-mono">Loading 3D Laser Scan geometry...</p>
    </div>
    <div id={containerId} class="w-full h-full cursor-grab active:cursor-grabbing"></div>
  </div>

  <div class="px-6 py-3 bg-neutral-950 text-xs text-neutral-400 border-t border-neutral-800 flex justify-between items-center">
    <span>Format: Wavefront OBJ &bull; NextEngine Scan &bull; CC BY-NC-SA 4.0</span>
    <a href="https://github.com/skidvision/Feelies" target="_blank" class="text-amber-400 hover:underline">
      View Dataset on GitHub &rarr;
    </a>
  </div>
</div>

<script define:vars={{ containerId, modelUrl }}>
  async function initViewer() {
    const container = document.getElementById(containerId);
    const loading = document.getElementById(`${containerId}-loading`);
    if (!container) return;

    const THREE = await import('three');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { OBJLoader } = await import('three/examples/jsm/loaders/OBJLoader.js');

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x121418);

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.set(0, 0, 160);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 1.8;

    // Lighting setup for perceptual material inspection
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xfff4e6, 2.0);
    keyLight.position.set(50, 80, 70);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xbfdbfe, 1.2);
    fillLight.position.set(-60, -30, -50);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0xfef08a, 1.0);
    rimLight.position.set(0, 80, -70);
    scene.add(rimLight);

    // Bakelite / smooth material
    const material = new THREE.MeshStandardMaterial({
      color: 0xd97706, // Amber/bakelite tone
      roughness: 0.35,
      metalness: 0.1,
      wireframe: false,
    });

    let meshObject = null;

    const loader = new OBJLoader();
    loader.load(
      modelUrl,
      (obj) => {
        meshObject = obj;
        // Center the geometry
        const box = new THREE.Box3().setFromObject(obj);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());
        obj.position.sub(center);

        // Apply material to all child meshes
        obj.traverse((child) => {
          if (child.isMesh) {
            child.material = material;
            child.geometry.computeVertexNormals();
          }
        });

        // Fit camera
        const maxDim = Math.max(size.x, size.y, size.z);
        camera.position.set(0, 0, maxDim * 1.8);
        controls.update();

        scene.add(obj);

        if (loading) {
          loading.style.opacity = '0';
          setTimeout(() => loading.remove(), 400);
        }
      },
      undefined,
      (error) => {
        console.error('Error loading OBJ:', error);
        if (loading) {
          loading.innerHTML = '<p class="text-xs text-red-400 font-mono">Failed to load 3D model file.</p>';
        }
      }
    );

    // Controls
    const wireframeBtn = document.getElementById(`${containerId}-wireframe`);
    wireframeBtn?.addEventListener('click', () => {
      material.wireframe = !material.wireframe;
      wireframeBtn.textContent = material.wireframe ? 'Solid' : 'Wireframe';
    });

    const rotateBtn = document.getElementById(`${containerId}-autorotate`);
    rotateBtn?.addEventListener('click', () => {
      controls.autoRotate = !controls.autoRotate;
      rotateBtn.textContent = controls.autoRotate ? 'Pause Spin' : 'Resume Spin';
    });

    const resetBtn = document.getElementById(`${containerId}-reset`);
    resetBtn?.addEventListener('click', () => {
      controls.reset();
      controls.autoRotate = true;
      if (rotateBtn) rotateBtn.textContent = 'Pause Spin';
    });

    // Resize handler
    function onResize() {
      if (!container) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    }
    window.addEventListener('resize', onResize);

    // Animation loop
    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }

  // Initialize when visible
  if (typeof window !== 'undefined') {
    initViewer();
  }
</script>
