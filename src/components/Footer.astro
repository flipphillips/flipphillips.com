---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900/40 mt-24 py-12 transition-colors">
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-sm text-neutral-500 dark:text-neutral-400">
      <p class="font-medium text-neutral-800 dark:text-neutral-200 font-serif">Flip Phillips</p>
      <p class="text-xs mt-1">Professor of Motion Picture Science, Rochester Institute of Technology</p>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-1">
        School of Film and Animation &bull; Center for Imaging Science &bull; MAGIC Center
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-5 text-sm text-neutral-600 dark:text-neutral-300">
      <a href="https://scholar.google.com/citations?user=b9u-pTsAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        Scholar
      </a>
      <a href="https://orcid.org/0000-0002-7281-8958" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        ORCID
      </a>
      <a href="https://github.com/flipphillips" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        GitHub
      </a>
      <a href="https://bsky.app/profile/flipphillips.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        Bluesky
      </a>
      <a href="https://www.linkedin.com/in/flipphillips" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        LinkedIn
      </a>
      <a href="https://drums.flipphillips.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        Jazz Drumming
      </a>
      <a href="mailto:flip.phillips@rit.edu" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
        Email
      </a>
    </div>
  </div>
  <div class="max-w-5xl mx-auto px-6 mt-8 pt-6 border-t border-neutral-200/60 dark:border-neutral-800/60 text-xs text-neutral-400 dark:text-neutral-500 text-center flex flex-col md:flex-row justify-between">
    <span>&copy; {currentYear} Flip Phillips. Licensed under CC BY-NC-SA 4.0.</span>
    <span class="mt-2 md:mt-0 italic font-mono text-[11px]">“part machine — titanium, Dacron, and cow”</span>
  </div>
</footer>
