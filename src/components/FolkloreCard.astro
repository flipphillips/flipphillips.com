---
interface Props {
  title: string;
  date: string;
  slug: string;
  excerpt?: string;
  tags?: string[];
  featuredImage?: string;
}

const { title, date, slug, excerpt, tags = [] } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="group relative flex flex-col justify-between p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 hover:border-blue-500/40 dark:hover:border-blue-500/40 hover:shadow-lg transition-all duration-200">
  <div>
    <div class="flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500 mb-3 font-mono">
      <time datetime={date}>{formattedDate}</time>
      <span class="px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-300 font-sans font-medium text-[11px]">
        Folklore
      </span>
    </div>

    <h3 class="text-lg font-serif font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
      <a href={`/blog/${slug}`} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    {excerpt && (
      <p class="mt-2.5 text-sm text-neutral-600 dark:text-neutral-300 line-clamp-3 leading-relaxed">
        {excerpt.replace(/\[Read More\].*$/, '')}
      </p>
    )}
  </div>

  <div class="mt-4 pt-4 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center justify-between font-mono">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map(tag => (
        <span class="text-[11px] text-neutral-500 dark:text-neutral-400">
          #{tag}
        </span>
      ))}
    </div>
    <span class="text-xs font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform font-sans">
      Read &rarr;
    </span>
  </div>
</article>
