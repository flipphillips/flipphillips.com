// Pick initial server-rendered item (Feelies is default for static prerender)
const initialItem = bannerItems[0];
---

<div class="pt-6 pb-2" id="random-banner-container">
  <div class="relative overflow-hidden rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100/70 dark:bg-neutral-900/60 transition-all shadow-xs">
    
    <!-- Image Stage -->
    <div class="relative w-full h-52 sm:h-64 md:h-72 flex items-center justify-center p-4 md:p-6 overflow-hidden">
      <img
        id="banner-image"
        src={initialItem.src}
        alt={initialItem.alt}
        class="max-h-full max-w-full object-contain filter drop-shadow-sm select-none transition-opacity duration-300"
        loading="eager"
      />
    </div>

    <!-- Bottom Caption & Controls Bar -->
    <div class="px-4 py-3 bg-white/80 dark:bg-neutral-900/90 border-t border-neutral-200/70 dark:border-neutral-800/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      
      <!-- Text details -->
      <div class="flex-grow min-w-0 pr-2">
        <div class="flex items-center gap-2">
          <span id="banner-counter" class="font-mono text-[11px] text-blue-600 dark:text-blue-400 font-semibold uppercase tracking-wider">
            Artifact 1 of {bannerItems.length}
          </span>
          <span class="text-neutral-300 dark:text-neutral-700">&bull;</span>
          <h3 id="banner-title" class="font-medium text-neutral-900 dark:text-neutral-100 truncate">
            {initialItem.title}
          </h3>
        </div>
        <p id="banner-subtitle" class="text-neutral-500 dark:text-neutral-400 text-[11px] truncate mt-0.5">
          {initialItem.subtitle}
        </p>
      </div>

      <!-- Controls & Link -->
      <div class="flex items-center justify-between sm:justify-end gap-2 shrink-0 pt-1 sm:pt-0 border-t sm:border-t-0 border-neutral-100 dark:border-neutral-800">
        <a
          id="banner-link"
          href={initialItem.link}
          class="font-medium text-blue-600 dark:text-blue-400 hover:underline mr-2"
        >
          <span id="banner-link-text">{initialItem.linkText}</span> &rarr;
        </a>

        <div class="flex items-center gap-1 font-mono">
          <button
            id="banner-prev"
            class="px-2 py-1 rounded-md border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer"
            title="Previous artifact"
            aria-label="Previous artifact"
          >
            &larr;
          </button>

          <button
            id="banner-random"
            class="px-2.5 py-1 rounded-md border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors flex items-center gap-1 cursor-pointer font-sans text-xs"
            title="Show random artifact"
            aria-label="Show random artifact"
          >
            <span>🎲</span>
            <span class="hidden md:inline">Shuffle</span>
          </button>

          <button
            id="banner-next"
            class="px-2 py-1 rounded-md border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer"
            title="Next artifact"
            aria-label="Next artifact"
          >
            &rarr;
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script define:vars={{ bannerItems }}>
  let currentIndex = 0;
  const imgEl = document.getElementById('banner-image');
  const titleEl = document.getElementById('banner-title');
  const subEl = document.getElementById('banner-subtitle');
  const counterEl = document.getElementById('banner-counter');
  const linkEl = document.getElementById('banner-link');
  const linkTextEl = document.getElementById('banner-link-text');

  function updateBanner(idx, animate = true) {
    if (!imgEl) return;
    currentIndex = (idx + bannerItems.length) % bannerItems.length;
    const item = bannerItems[currentIndex];

    if (animate) {
      imgEl.style.opacity = '0.3';
      setTimeout(() => {
        imgEl.src = item.src;
        imgEl.alt = item.alt;
        imgEl.style.opacity = '1';
      }, 150);
    } else {
      imgEl.src = item.src;
      imgEl.alt = item.alt;
    }

    if (titleEl) titleEl.textContent = item.title;
    if (subEl) subEl.textContent = item.subtitle;
    if (counterEl) counterEl.textContent = `Artifact ${currentIndex + 1} of ${bannerItems.length}`;
    if (linkEl && linkTextEl) {
      linkEl.href = item.link;
      linkTextEl.textContent = item.linkText;
    }
  }

  // Randomize on initial load in browser so each page visit shows a different artifact
  const initialRandomIndex = Math.floor(Math.random() * bannerItems.length);
  if (initialRandomIndex !== 0) {
    updateBanner(initialRandomIndex, false);
  }

  document.getElementById('banner-prev')?.addEventListener('click', () => {
    updateBanner(currentIndex - 1);
  });

  document.getElementById('banner-next')?.addEventListener('click', () => {
    updateBanner(currentIndex + 1);
  });

  document.getElementById('banner-random')?.addEventListener('click', () => {
    let newIdx = Math.floor(Math.random() * bannerItems.length);
    if (newIdx === currentIndex) {
      newIdx = (newIdx + 1) % bannerItems.length;
    }
    updateBanner(newIdx);
  });
</script>
